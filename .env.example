# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
#
# Reverse proxies in front of the API, for Express's `trust proxy` — and so for
# the client IP every throttle keys on. Unset: 1 when NODE_ENV=production (Cloud
# Run adds exactly one hop), 0 otherwise (no proxy locally; trusting one that is
# not there lets a client pick its own IP via X-Forwarded-For).
# TRUST_PROXY_HOPS=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Ignored when NODE_ENV=development (all origins allowed).
# Comma-separated list of allowed origins for production, e.g.:
# CORS_ORIGINS=https://app.portvilla.com,https://admin.portvilla.com
CORS_ORIGINS=

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/portvilla

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRY_SECONDS=604800

# ─── Nodemailer (SMTP) ───────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="Portvilla <noreply@portvilla.com>"

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=15
OTP_LENGTH=6

# ─── GitHub Parser ───────────────────────────────────────────────────────────
# Optional — raises rate limit from 60 to 5000 req/hr.
# Generate at: https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# ─── Platform LLM ────────────────────────────────────────────────────────────
# Portvilla's OWN key, for work Portvilla initiates on an owner's behalf:
# résumé extraction during onboarding, and drafting a profile from the owner's
# description (POST /profiles/me/generate). This is NOT profile.aiSettings, which is the
# owner's own key for their own agent — see docs/plan/PLAN.md §8.
#
# Optional. Unset means those features are simply off: résumé upload still
# succeeds and returns no suggestions, and the owner types their sections.
#
# PLATFORM_LLM_PROVIDER: openai | anthropic | groq | deepseek | ollama | custom
# (an unset or unrecognised value falls back to openai).
# PLATFORM_LLM_MODEL / _BASE_URL: optional; each provider has its own default.
# On anthropic, generation marks the shared prefix cacheable and warms it once
# before the fan-out; claude-opus-5 / -5-5 / fable-5 / fable-5-1 also opt into
# server-side refusal fallbacks ("default"). Each generation logs its counts:
# in / cacheRead / cacheWrite / out / ms.
PLATFORM_LLM_PROVIDER=anthropic
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=claude-opus-5
PLATFORM_LLM_BASE_URL=
#
# Deprecated: RESUME_LLM_PROVIDER / _API_KEY / _MODEL / _BASE_URL are still read
# as a fallback when PLATFORM_LLM_API_KEY is unset, and log a deprecation
# warning once. Rename them; the fallback is removed after one release.

# ─── Agent worker (portvilla-agent) ──────────────────────────────────────────
# Shared secret for GET /agent/context/:username. Required — the app will not
# boot without it, so the endpoint can never come up unguarded. Must be >= 24
# chars and match AGENT_SERVICE_TOKEN in the portvilla-agent worker.
# Generate with: openssl rand -hex 32
AGENT_SERVICE_TOKEN=change-me-openssl-rand-hex-32

# ─── Session cost guards ─────────────────────────────────────────────────────
# Minutes of ENDED voice conversation one profile may consume per UTC calendar
# month before POST /session answers 429 { code: "MINUTE_BUDGET_EXHAUSTED" }.
# Unset = 120. Set 0 for unlimited (your own environment only). Per-session
# duration and idle limits live in the portvilla-agent worker's env.
# See docs/decisions/2026-09-13-session-cost-guards.md
MONTHLY_MINUTES_PER_PROFILE=120

# ─── Demo seed (pnpm seed:demo) ──────────────────────────────────────────────
# The account that owns the `portvilla` demo profile — Portvilla describing
# itself. Local and staging only: the script refuses to run with
# NODE_ENV=production.
#
# DEMO_USER_EMAIL is always needed. DEMO_USER_PASSWORD is only needed the first
# time, when the account is created; afterwards the stored password is kept.
# A dry run (`pnpm seed:demo`, no --apply) reads and writes nothing.
DEMO_USER_EMAIL=demo@portvilla.in
DEMO_USER_PASSWORD=

# ─── Cloudflare R2 (asset uploads) ───────────────────────────────────────────
# Leave R2_ACCOUNT_ID empty in development: uploads go to .local-storage/ on
# this machine instead. Once R2_ACCOUNT_ID is set, every other R2_* key is
# required and the app refuses to boot without them. In any NODE_ENV other
# than development/test, an empty R2_ACCOUNT_ID disables the /assets endpoints
# (503) rather than falling back to local disk.
# The token must be scoped to object read/write on these two buckets only.
# See docs/decisions/2026-08-26-media-uploads-r2.md and src/asset/README.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_QUARANTINE=portvilla-quarantine
R2_BUCKET_MEDIA=portvilla-media
R2_PUBLIC_BASE_URL=https://cdn.portvilla.com
